DATABASE_URL=postgres://apollo_platform_runtime:change-me@127.0.0.1:5432/apollo
APOLLO_REDIS_URL=redis://127.0.0.1:6379
PORT=3000
APOLLO_ALLOWED_ORIGINS=https://apollot.ru,https://admin.apollot.ru
APOLLO_ASSERTION_PRIVATE_JWK_FILE=/run/secrets/platform_assertion_private_jwk
APOLLO_ASSERTION_PUBLIC_JWKS_FILE=/run/secrets/platform_assertion_public_jwks
APOLLO_INTROSPECTION_CLIENT_ID=apollo-tf-api
APOLLO_ISSUER=https://api.apollot.ru
APOLLO_OAUTH_CLIENTS_FILE=/run/secrets/platform_oauth_clients
APOLLO_OPERATOR_BOOTSTRAP_TOKEN=replace-with-a-one-time-secret
APOLLO_DEVELOPMENT_TOKEN_ECHO=false
APOLLO_TRUST_PROXY_HOPS=0
NODE_ENV=development
