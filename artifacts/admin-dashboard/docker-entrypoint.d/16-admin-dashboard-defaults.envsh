#!/bin/sh

ADMIN_DASHBOARD_TOKEN_FILE="/run/secrets/admin_dashboard_token"
ADMIN_ACCESS_HTPASSWD_FILE="/run/secrets/admin_access_htpasswd"
ADMIN_ACCESS_USER_FILE="/run/secrets/admin_access_user"
ADMIN_ACCESS_PASSWORD_FILE="/run/secrets/admin_access_password"

umask 077
carriage_return="$(printf '\r')"

read_secret_file() {
  file_path="$1"
  minimum_bytes="$2"
  maximum_bytes="$3"
  secret_value=

  [ -f "$file_path" ] && [ -r "$file_path" ] || return 1
  secret_size="$(wc -c < "$file_path")" || return 1
  case "$secret_size" in
    ""|*[!0-9]*) return 1 ;;
  esac
  [ "$secret_size" -ge "$minimum_bytes" ] || return 1
  [ "$secret_size" -le "$maximum_bytes" ] || return 1

  secret_value="$(cat "$file_path"; printf '\001')" || return 1
  secret_value="${secret_value%?}"
  case "$secret_value" in
    *"$carriage_return"*|*'
'*) return 1 ;;
  esac
  actual_size="$(printf '%s' "$secret_value" | wc -c)" || return 1
  [ "$actual_size" -eq "$secret_size" ] || return 1
}

unset ADMIN_DASHBOARD_TOKEN
unset ADMIN_ACCESS_HTPASSWD
unset ADMIN_ACCESS_USER
unset ADMIN_ACCESS_PASSWORD
admin_dashboard_token=
admin_access_htpasswd=
admin_access_user=
admin_access_password=
admin_password_hash=
admin_configuration_valid=true

if read_secret_file "$ADMIN_DASHBOARD_TOKEN_FILE" 32 4096; then
  admin_dashboard_token="$secret_value"
else
  admin_configuration_valid=false
fi
if [ -e "$ADMIN_ACCESS_HTPASSWD_FILE" ]; then
  if read_secret_file "$ADMIN_ACCESS_HTPASSWD_FILE" 62 260 &&
    printf '%s\n' "$secret_value" |
      grep -Eq '^[A-Za-z0-9_.@-]{1,128}:\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$'; then
    admin_access_htpasswd="$secret_value"
  else
    admin_configuration_valid=false
  fi
else
  if read_secret_file "$ADMIN_ACCESS_USER_FILE" 1 128; then
    admin_access_user="$secret_value"
  else
    admin_configuration_valid=false
  fi
  if read_secret_file "$ADMIN_ACCESS_PASSWORD_FILE" 16 4096; then
    admin_access_password="$secret_value"
  else
    admin_configuration_valid=false
  fi

  case "$admin_access_user" in
    ""|*[!a-zA-Z0-9_.@-]*)
      admin_configuration_valid=false
      ;;
  esac
fi

if [ "$admin_configuration_valid" != true ]; then
  unset admin_dashboard_token admin_access_htpasswd
  unset admin_access_user admin_access_password
  unset admin_password_hash admin_configuration_valid secret_value
  exit 1
fi

export ADMIN_DASHBOARD_TOKEN="$admin_dashboard_token"
if [ -n "$admin_access_htpasswd" ]; then
  printf '%s\n' "$admin_access_htpasswd" > /etc/nginx/.htpasswd
else
  admin_password_hash="$(printf '%s\n' "$admin_access_password" | mkpasswd -P 0 -m sha512)" || exit 1
  [ -n "$admin_password_hash" ] || exit 1
  printf '%s:%s\n' "$admin_access_user" "$admin_password_hash" > /etc/nginx/.htpasswd
fi
chown root:nginx /etc/nginx/.htpasswd
chmod 640 /etc/nginx/.htpasswd
unset admin_dashboard_token admin_access_htpasswd
unset admin_access_user admin_access_password admin_password_hash
unset admin_configuration_valid actual_size secret_size secret_value
unset carriage_return file_path minimum_bytes maximum_bytes
