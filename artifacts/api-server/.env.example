# Spotify API credentials (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Database (managed automatically by docker-compose, override if using external DB)
# DATABASE_URL=postgres://apollo:apollo_secret@localhost:5432/apollo_trackfinder

# Redis (managed automatically by docker-compose, override if using external Redis)
# REDIS_URL=redis://redis:6379
# If REDIS_URL is not set, the server falls back to PostgreSQL-based search cache.

# Your server's public URL — REQUIRED for Spotify OAuth on self-hosted server
# Must match the redirect URI registered in Spotify Dashboard
# Example: SERVER_URL=https://api.yourdomain.com
# Register this in Spotify Dashboard: https://api.yourdomain.com/api/spotify/callback
SERVER_URL=https://your-api-domain.com

# Optional
# LOG_LEVEL=info

# Apollo Platform-backed TF authentication (required before the API listens)
APOLLO_PLATFORM_ISSUER=https://api.apollot.ru
# Optional server-only HTTPS transport when it differs from the public issuer.
APOLLO_PLATFORM_API_ORIGIN=https://api.apollot.ru
APOLLO_TF_CLIENT_ID=apollo-tf-api
APOLLO_TF_CALLBACK_URL=https://api.tf.apollot.ru/api/auth/callback
APOLLO_TF_WEB_ORIGIN=https://tf.apollot.ru
APOLLO_TF_CLIENT_SECRET_FILE=/run/secrets/apollo_tf_client_secret
APOLLO_TF_AUTH_REDIS_URL=redis://redis:6379/1

# Disposable local bridge only. Production rejects this HTTP transport mode.
# APOLLO_TF_BRIDGE_ALLOW_INTERNAL_HTTP=true
# APOLLO_TF_BRIDGE_PKCE_VERIFIER_FILE=/run/secrets/tf_pkce_verifier
